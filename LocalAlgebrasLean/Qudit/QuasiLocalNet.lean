import LocalAlgebrasLean.Qudit.QuasiLocal
import LocalAlgebrasLean.Net.Generated
import LocalAlgebrasLean.Lattice.Basic
import Mathlib.Topology.Algebra.Group.Basic
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-!
# The quasi-local net of an infinite lattice

The strictly local operators of a region `O` are the operators `ι_X(m)` with `X ⊆ O` finite;
they form a star subalgebra, and the quasi-local net is the net generated by them
(`Net.generated`), so that its algebra of `O` is their norm closure. The net is locally
commutative for the regions of the sites, because commuting generators have commuting closed
generated star algebras (`Net.generated_isLocallyCommutative`). Read inside the quasi-local
algebra `A(Λ)`, the same local algebras form a generating net, already generated by the finite
regions. On a finite region the strictly local operators are already closed and the local
embedding is a star isomorphism onto the local algebra; on a finite lattice the quasi-local net
is isomorphic to the qudit net. When only finitely many sites carry more than one letter, the
net is generating in the bounded operators.

## Main definitions

* `LocalAlgebrasLean.Qudit.strictlyLocal`, `quasiLocalNet`.
* `LocalAlgebrasLean.Qudit.quasiLocalAlgebra`, `qlNet`: the quasi-local algebra and the net in it.
* `LocalAlgebrasLean.Qudit.localEmbedEquiv`, `localEmbedUnivEquiv`: the local embedding of a
  finite region, and of a finite lattice, as a star isomorphism onto its range.

## Main statements

* `mem_strictlyLocal_iff_finite`, `mem_strictlyLocal_iff_finset`: the finite regions given by
  `X.Finite` or by `Finset Λ`.
* `quasiLocalNet_eq_closure`, `quasiLocalNet_isLocallyCommutative`.
* `map_qlNet`, `qlNet_isGenerating`, `qlNet_isLocallyCommutative`, `dense_strictlyLocal`,
  `dense_iUnion_qlNet_finite`: the net in the quasi-local algebra.
* `localEmbed_surjective`, `quasiLocalNet_isGenerating_of_finite_nontrivial`: finitely many sites
  with two or more letters.
* `quasiLocalNet_finite`, `map_localAlgebra_localEmbed`, `quasiLocalAlgebra_eq_top_of_finite`,
  `quasiLocalNet_isGenerating_of_finite`, `quditNet_isomorphic_quasiLocalNet`,
  `qlNet_isomorphic_quasiLocalNet_of_finite`: finite regions and finite lattices.
-/

open scoped ComplexConjugate

noncomputable section

namespace LocalAlgebrasLean.Qudit

/-! ### The strictly local operators and the quasi-local net -/

section Net

variable {Λ : Type*} {σ : Λ → Type*} [DecidableEq Λ] [∀ u, Fintype (σ u)]
  [∀ u, DecidableEq (σ u)] (s₀ : Config σ)

/-- Two strictly local operators of `O` are local embeddings of one finite subregion of `O`. -/
theorem exists_common_localEmbed {O : Set Λ} {a b : ConfigSpace s₀ →L[ℂ] ConfigSpace s₀}
    (ha : ∃ (X : Set Λ) (_ : Fintype X), X ⊆ O ∧ a ∈ Set.range (localEmbed s₀ X))
    (hb : ∃ (X : Set Λ) (_ : Fintype X), X ⊆ O ∧ b ∈ Set.range (localEmbed s₀ X)) :
    ∃ (Z : Set Λ) (_ : Fintype Z), Z ⊆ O ∧
      ∃ m n, localEmbed s₀ Z m = a ∧ localEmbed s₀ Z n = b := by
  obtain ⟨X, _, hX, m, rfl⟩ := ha
  obtain ⟨Y, _, hY, n, rfl⟩ := hb
  obtain ⟨m', hm'⟩ := range_localEmbed_mono s₀ (Set.subset_union_left (t := Y)) ⟨m, rfl⟩
  obtain ⟨n', hn'⟩ := range_localEmbed_mono s₀ (Set.subset_union_right (s := X)) ⟨n, rfl⟩
  exact ⟨X ∪ Y, inferInstance, Set.union_subset hX hY, m', n', hm', hn'⟩

/-- The strictly local operators of a region `O`, the local embeddings `ι_X(m)` of the finite
regions `X ⊆ O`, form a star subalgebra of the bounded operators. -/
def strictlyLocal (O : Set Λ) : StarSubalgebra ℂ (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀) where
  carrier := {a | ∃ (X : Set Λ) (_ : Fintype X), X ⊆ O ∧ a ∈ Set.range (localEmbed s₀ X)}
  mul_mem' ha hb := by
    obtain ⟨Z, _, hZ, m, n, rfl, rfl⟩ := exists_common_localEmbed s₀ ha hb
    exact ⟨Z, inferInstance, hZ, m * n, map_mul _ m n⟩
  add_mem' ha hb := by
    obtain ⟨Z, _, hZ, m, n, rfl, rfl⟩ := exists_common_localEmbed s₀ ha hb
    exact ⟨Z, inferInstance, hZ, m + n, map_add _ m n⟩
  algebraMap_mem' c :=
    ⟨∅, inferInstance, Set.empty_subset _, algebraMap ℂ _ c, AlgHomClass.commutes _ c⟩
  star_mem' := by
    rintro a ⟨X, _, hX, m, rfl⟩
    exact ⟨X, inferInstance, hX, star m, map_star _ m⟩

variable {s₀}

theorem mem_strictlyLocal {O : Set Λ} {a : ConfigSpace s₀ →L[ℂ] ConfigSpace s₀} :
    a ∈ strictlyLocal s₀ O ↔
      ∃ (X : Set Λ) (_ : Fintype X), X ⊆ O ∧ a ∈ Set.range (localEmbed s₀ X) :=
  Iff.rfl

/-- The strictly local operators with the finite regions given by `X.Finite`; the instance
`Fintype X` is then `Set.Finite.fintype`, and any other gives the same operators
(`localEmbed_congr_fintype`). -/
theorem mem_strictlyLocal_iff_finite {O : Set Λ} {a : ConfigSpace s₀ →L[ℂ] ConfigSpace s₀} :
    a ∈ strictlyLocal s₀ O ↔
      ∃ (X : Set Λ) (hX : X.Finite), X ⊆ O ∧
        a ∈ Set.range (@localEmbed Λ σ _ _ s₀ X hX.fintype _) := by
  constructor
  · rintro ⟨X, i, hXO, m, rfl⟩
    exact ⟨X, X.toFinite, hXO, m, localEmbed_congr_fintype s₀ X _ i m⟩
  · rintro ⟨X, hX, hXO, ha⟩
    exact ⟨X, hX.fintype, hXO, ha⟩

/-- The strictly local operators with the finite regions given as `Finset Λ`, the indexing of the
finite regions used for compatible families (`IsCompatibleFamily`). -/
theorem mem_strictlyLocal_iff_finset {O : Set Λ} {a : ConfigSpace s₀ →L[ℂ] ConfigSpace s₀} :
    a ∈ strictlyLocal s₀ O ↔
      ∃ X : Finset Λ, (X : Set Λ) ⊆ O ∧ a ∈ Set.range (localEmbed s₀ (X : Set Λ)) := by
  constructor
  · rintro ⟨X, i, hXO, m, rfl⟩
    obtain ⟨Y, rfl⟩ := X.toFinite.exists_finset_coe
    exact ⟨Y, hXO, m, localEmbed_congr_fintype s₀ _ _ i m⟩
  · rintro ⟨X, hXO, ha⟩
    exact ⟨X, inferInstance, hXO, ha⟩

theorem localEmbed_mem_strictlyLocal {O X : Set Λ} [Fintype X] (hX : X ⊆ O)
    (m : Matrix ((x : X) → σ x) ((x : X) → σ x) ℂ) :
    localEmbed s₀ X m ∈ strictlyLocal s₀ O :=
  ⟨X, inferInstance, hX, m, rfl⟩

variable (s₀) in
/-- Isotony of the strictly local operators: `A₀(O) ⊆ A₀(O')` for `O ⊆ O'`. -/
theorem strictlyLocal_mono {O O' : Set Λ} (h : O ⊆ O') :
    strictlyLocal s₀ O ≤ strictlyLocal s₀ O' := by
  rintro a ⟨X, _, hX, ha⟩
  exact ⟨X, inferInstance, hX.trans h, ha⟩

variable (s₀)

/-- The quasi-local net, the net generated (`Net.generated`) by the strictly local operators; its
algebra of `O` is the closed star subalgebra of the bounded operators generated by `A₀(O)`. -/
def quasiLocalNet : Net (Set Λ) (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀) :=
  Net.generated
    { toFun := fun O => (strictlyLocal s₀ O : Set (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀))
      monotone' := fun _ _ h => strictlyLocal_mono s₀ h }

theorem quasiLocalNet_apply (O : Set Λ) :
    quasiLocalNet s₀ O =
      (StarAlgebra.adjoin ℂ (strictlyLocal s₀ O : Set (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀))
        ).topologicalClosure :=
  rfl

/-- The algebra of `O` is the closure of the strictly local operators, `A(O) = closure A₀(O)`. -/
theorem quasiLocalNet_eq_closure (O : Set Λ) :
    quasiLocalNet s₀ O = (strictlyLocal s₀ O).topologicalClosure := by
  rw [quasiLocalNet_apply, StarAlgebra.adjoin_eq]

theorem coe_quasiLocalNet (O : Set Λ) :
    (quasiLocalNet s₀ O : Set (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀)) =
      closure (strictlyLocal s₀ O : Set (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀)) := by
  rw [quasiLocalNet_eq_closure, StarSubalgebra.topologicalClosure_coe]

theorem strictlyLocal_le_quasiLocalNet (O : Set Λ) :
    strictlyLocal s₀ O ≤ quasiLocalNet s₀ O := by
  rw [quasiLocalNet_eq_closure]
  exact StarSubalgebra.le_topologicalClosure _

/-- The local embedding of a finite subregion of `O` lands in `A(O)`. -/
theorem localEmbed_mem_quasiLocalNet {O X : Set Λ} [Fintype X] (hX : X ⊆ O)
    (m : Matrix ((x : X) → σ x) ((x : X) → σ x) ℂ) :
    localEmbed s₀ X m ∈ quasiLocalNet s₀ O :=
  strictlyLocal_le_quasiLocalNet s₀ O (localEmbed_mem_strictlyLocal hX m)

/-- The quasi-local net is locally commutative for the regions of the sites; the algebras of
disjoint regions commute. -/
theorem quasiLocalNet_isLocallyCommutative :
    (quasiLocalNet s₀).IsLocallyCommutative (subsetIndex Λ) := by
  refine Net.generated_isLocallyCommutative _
    (fun O a (ha : a ∈ strictlyLocal s₀ O) => star_mem ha) fun O₁ O₂ hO a ha b hb => ?_
  rw [subsetIndex_orthogonal] at hO
  obtain ⟨X, _, hX, m, rfl⟩ := mem_strictlyLocal.1 ha
  obtain ⟨Y, _, hY, n, rfl⟩ := mem_strictlyLocal.1 hb
  exact commute_localEmbed_of_disjoint s₀ (hO.mono hX hY) m n

end Net

/-! ### The net in the quasi-local algebra -/

section QuasiLocal

variable {Λ : Type*} {σ : Λ → Type*} [DecidableEq Λ] [∀ u, Fintype (σ u)]
  [∀ u, DecidableEq (σ u)] (s₀ : Config σ)

/-- The quasi-local algebra `A(Λ)`, a C*-subalgebra of the bounded operators. -/
def quasiLocalAlgebra : StarSubalgebra ℂ (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀) :=
  quasiLocalNet s₀ Set.univ

instance : IsClosed (quasiLocalAlgebra s₀ : Set (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀)) :=
  (quasiLocalNet s₀).isClosed Set.univ

theorem quasiLocalNet_le_quasiLocalAlgebra (O : Set Λ) :
    quasiLocalNet s₀ O ≤ quasiLocalAlgebra s₀ :=
  (quasiLocalNet s₀).mono (Set.subset_univ O)

/-- The restricted net `A_ql` in the quasi-local algebra, `A_ql(O)` the algebra `A(O)` read as a
subset of `A(Λ)`. -/
def qlNet : Net (Set Λ) (quasiLocalAlgebra s₀) where
  toOrderHom :=
    { toFun := fun O => (quasiLocalNet s₀ O).comap (quasiLocalAlgebra s₀).subtype
      monotone' := fun _ _ h _ ha => (quasiLocalNet s₀).mono h ha }
  isClosed O := ((quasiLocalNet s₀).isClosed O).preimage continuous_subtype_val

variable {s₀} in
theorem mem_qlNet {O : Set Λ} {a : quasiLocalAlgebra s₀} :
    a ∈ qlNet s₀ O ↔ (a : ConfigSpace s₀ →L[ℂ] ConfigSpace s₀) ∈ quasiLocalNet s₀ O :=
  Iff.rfl

/-- The inclusion `j : A(Λ) → B` maps `A_ql(O)` onto `A(O)`. -/
theorem map_qlNet (O : Set Λ) :
    (qlNet s₀ O).map (quasiLocalAlgebra s₀).subtype = quasiLocalNet s₀ O := by
  ext b
  rw [StarSubalgebra.mem_map]
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact ha
  · intro hb
    exact ⟨⟨b, quasiLocalNet_le_quasiLocalAlgebra s₀ O hb⟩, hb, rfl⟩

theorem qlNet_univ : qlNet s₀ Set.univ = ⊤ :=
  eq_top_iff.2 fun a _ => a.2

/-- The restricted net is generating in the quasi-local algebra. -/
theorem qlNet_isGenerating : (qlNet s₀).IsGenerating := by
  rw [Net.IsGenerating, eq_top_iff, ← qlNet_univ]
  exact (le_iSup (fun O => qlNet s₀ O) Set.univ).trans (StarSubalgebra.le_topologicalClosure _)

/-- The restricted net is locally commutative for the regions of the sites. -/
theorem qlNet_isLocallyCommutative : (qlNet s₀).IsLocallyCommutative (subsetIndex Λ) :=
  fun _ _ hO a ha b hb => Subtype.ext (quasiLocalNet_isLocallyCommutative s₀ hO a ha b hb)

/-- The strictly local operators are dense in the quasi-local algebra. -/
theorem dense_strictlyLocal :
    Dense {a : quasiLocalAlgebra s₀ |
      (a : ConfigSpace s₀ →L[ℂ] ConfigSpace s₀) ∈ strictlyLocal s₀ Set.univ} := by
  rw [Subtype.dense_iff]
  intro b hb
  have hb' : b ∈ closure
      (strictlyLocal s₀ Set.univ : Set (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀)) := by
    rw [← coe_quasiLocalNet]
    exact hb
  refine closure_mono ?_ hb'
  intro c hc
  exact ⟨⟨c, strictlyLocal_le_quasiLocalNet s₀ _ hc⟩, hc, rfl⟩

/-- The algebras of the finite regions already generate, their union being dense in the quasi-local
algebra. -/
theorem dense_iUnion_qlNet_finite :
    Dense (⋃ (X : Set Λ) (_ : X.Finite), (qlNet s₀ X : Set (quasiLocalAlgebra s₀))) := by
  refine (dense_strictlyLocal s₀).mono ?_
  intro a ha
  obtain ⟨X, _, -, m, hm⟩ := mem_strictlyLocal.1 ha
  refine Set.mem_iUnion₂.2 ⟨X, X.toFinite, ?_⟩
  rw [SetLike.mem_coe, mem_qlNet, ← hm]
  exact localEmbed_mem_quasiLocalNet s₀ subset_rfl m

/-- When the quasi-local algebra is all of the bounded operators, the restricted net is isomorphic
to the quasi-local net, through the inclusion; this is the case on a finite lattice
(`qlNet_isomorphic_quasiLocalNet_of_finite`). -/
theorem qlNet_isomorphic_quasiLocalNet (h : quasiLocalAlgebra s₀ = ⊤) :
    Net.Isomorphic (subsetIndex Λ) (qlNet s₀) (quasiLocalNet s₀) := by
  have hbij : Function.Bijective (quasiLocalAlgebra s₀).subtype :=
    ⟨Subtype.val_injective, fun b => ⟨⟨b, h ▸ StarSubalgebra.mem_top⟩, rfl⟩⟩
  refine ⟨StarAlgEquiv.ofBijective (quasiLocalAlgebra s₀).subtype hbij, fun O => ?_⟩
  have he : (StarAlgEquiv.ofBijective (quasiLocalAlgebra s₀).subtype hbij).toStarAlgHom =
      (quasiLocalAlgebra s₀).subtype :=
    StarAlgHom.ext fun _ => rfl
  rw [he]
  exact map_qlNet s₀ O

end QuasiLocal

/-! ### Generation when finitely many sites carry two or more letters -/

section Generation

variable {Λ : Type*} {σ : Λ → Type*} [DecidableEq Λ] [∀ u, Fintype (σ u)]
  [∀ u, DecidableEq (σ u)] {s₀ : Config σ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

omit [DecidableEq Λ] [∀ u, Fintype (σ u)] [∀ u, DecidableEq (σ u)] in
open Classical in
/-- Bounded operators from `ℓ²` of the finitely supported configurations agreeing on the basis
vectors are equal. -/
theorem ConfigSpace.ext_single {S T : ConfigSpace s₀ →L[ℂ] E}
    (h : ∀ t, S (lp.single 2 t (1 : ℂ) : ConfigSpace s₀) =
      T (lp.single 2 t (1 : ℂ) : ConfigSpace s₀)) : S = T := by
  ext1 ψ
  have hψ := lp.hasSum_single (E := fun _ : FinConfig s₀ => ℂ) ENNReal.ofNat_ne_top ψ
  have hs : ∀ t, (lp.single 2 t (ψ t) : ConfigSpace s₀) =
      ψ t • (lp.single 2 t (1 : ℂ) : ConfigSpace s₀) := fun t => by
    rw [← lp.single_smul, smul_eq_mul, mul_one]
  refine (hψ.mapL S).unique ?_
  convert hψ.mapL T using 1
  funext t
  simp only [hs, map_smul, h]

variable (s₀) in
open Classical in
/-- If every site off the finite region `X` has a single letter, every bounded operator is a local
embedding of `X`, whose matrix in the basis `(e_s)` is `(s, t) ↦ m(s_X, t_X)`. -/
theorem localEmbed_surjective (X : Set Λ) [Fintype X] (hX : ∀ u ∉ X, Subsingleton (σ u)) :
    Function.Surjective (localEmbed s₀ X) := by
  intro T
  have hag : ∀ s t : FinConfig s₀, AgreesOff X s.1 t.1 := fun s t u hu => by
    have := hX u hu
    exact Subsingleton.elim _ _
  have hg : ∀ s : FinConfig s₀, glueFin X (restrict X s.1) (refFin s₀) = s := fun s =>
    Subtype.ext (glue_restrict (hag s (refFin s₀)))
  refine ⟨Matrix.of fun ξ η =>
    (T (lp.single 2 (glueFin X η (refFin s₀)) 1)) (glueFin X ξ (refFin s₀)), ?_⟩
  refine ConfigSpace.ext_single fun t => lp.ext (funext fun s => ?_)
  rw [localEmbed_single_apply, ite_eq_left (hag s t), Matrix.of_apply, hg, hg]

variable (s₀) in
/-- If only finitely many sites carry two or more letters, the quasi-local algebra is all of the
bounded operators. -/
theorem quasiLocalAlgebra_eq_top_of_finite_nontrivial (h : {u | Nontrivial (σ u)}.Finite) :
    quasiLocalAlgebra s₀ = ⊤ := by
  have : Fintype {u | Nontrivial (σ u)} := h.fintype
  refine eq_top_iff.2 fun T _ => ?_
  obtain ⟨m, rfl⟩ := localEmbed_surjective s₀ {u | Nontrivial (σ u)}
    (fun u hu => not_nontrivial_iff_subsingleton.1 hu) T
  exact localEmbed_mem_quasiLocalNet s₀ (Set.subset_univ _) m

variable (s₀) in
/-- If only finitely many sites carry two or more letters, the quasi-local net is generating in the
bounded operators. -/
theorem quasiLocalNet_isGenerating_of_finite_nontrivial (h : {u | Nontrivial (σ u)}.Finite) :
    (quasiLocalNet s₀).IsGenerating := by
  rw [Net.IsGenerating, eq_top_iff, ← quasiLocalAlgebra_eq_top_of_finite_nontrivial s₀ h]
  exact (le_iSup (fun O => quasiLocalNet s₀ O) Set.univ).trans
    (StarSubalgebra.le_topologicalClosure _)

end Generation

/-! ### Finite regions and finite lattices -/

section Finite

open scoped Matrix.Norms.L2Operator

variable {Λ : Type*} {σ : Λ → Type*} [DecidableEq Λ] [∀ u, Fintype (σ u)]
  [∀ u, DecidableEq (σ u)] (s₀ : Config σ)

variable {s₀} in
theorem mem_range_localEmbed {X : Set Λ} [Fintype X] {a : ConfigSpace s₀ →L[ℂ] ConfigSpace s₀} :
    a ∈ (localEmbed s₀ X).range ↔ a ∈ Set.range (localEmbed s₀ X) :=
  AlgHom.mem_range _

/-- For finite `X`, `A₀(X) = ι_X(M_X)`. -/
theorem strictlyLocal_finite (X : Set Λ) [Fintype X] :
    strictlyLocal s₀ X = (localEmbed s₀ X).range := by
  ext a
  rw [mem_strictlyLocal, mem_range_localEmbed]
  constructor
  · rintro ⟨Y, _, hY, ha⟩
    exact range_localEmbed_mono s₀ hY ha
  · exact fun ha => ⟨X, inferInstance, subset_rfl, ha⟩

/-- The range of the local embedding of a finite region is closed, being a finite-dimensional
subspace. -/
theorem isClosed_range_localEmbed (X : Set Λ) [Fintype X] :
    IsClosed ((localEmbed s₀ X).range : Set (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀)) := by
  have hc := (LinearMap.range (localEmbed s₀ X).toLinearMap).closed_of_finiteDimensional
  convert hc using 1
  ext a
  rw [SetLike.mem_coe, SetLike.mem_coe, mem_range_localEmbed, LinearMap.mem_range]
  rfl

/-- For finite `X`, `A(X) = ι_X(M_X)`. -/
theorem quasiLocalNet_finite (X : Set Λ) [Fintype X] :
    quasiLocalNet s₀ X = (localEmbed s₀ X).range := by
  rw [quasiLocalNet_eq_closure, strictlyLocal_finite]
  exact le_antisymm
    (StarSubalgebra.topologicalClosure_minimal le_rfl (isClosed_range_localEmbed s₀ X))
    (StarSubalgebra.le_topologicalClosure _)

/-- For finite `X`, the local embedding is a star isomorphism of the qudit algebra `M_X` onto
`A(X)`. -/
def localEmbedEquiv (X : Set Λ) [Fintype X] :
    Matrix ((x : X) → σ x) ((x : X) → σ x) ℂ ≃⋆ₐ[ℂ] quasiLocalNet s₀ X :=
  StarAlgEquiv.ofBijective
    ((localEmbed s₀ X).codRestrict _ fun m => localEmbed_mem_quasiLocalNet s₀ subset_rfl m)
    ⟨fun m n h => localEmbed_injective s₀ X (congrArg Subtype.val h), fun a => by
      have ha : (a : ConfigSpace s₀ →L[ℂ] ConfigSpace s₀) ∈ (localEmbed s₀ X).range := by
        rw [← quasiLocalNet_finite]
        exact a.2
      obtain ⟨m, hm⟩ := mem_range_localEmbed.1 ha
      exact ⟨m, Subtype.ext hm⟩⟩

theorem coe_localEmbedEquiv_apply (X : Set Λ) [Fintype X]
    (m : Matrix ((x : X) → σ x) ((x : X) → σ x) ℂ) :
    (localEmbedEquiv s₀ X m : ConfigSpace s₀ →L[ℂ] ConfigSpace s₀) = localEmbed s₀ X m :=
  rfl

/-- For finite `X` and `Y ⊆ X`, the local embedding `ι_X` carries the local algebra of `Y` in the
qudit algebra `M_X` of the site set `X` (`localAlgebra`) onto `A(Y)`. -/
theorem map_localAlgebra_localEmbed {X Y : Set Λ} [Fintype X] (hYX : Y ⊆ X) :
    (localAlgebra (σ := fun x : X => σ x) (Subtype.val ⁻¹' Y)).map (localEmbed s₀ X) =
      quasiLocalNet s₀ Y := by
  have : ∀ u, Nonempty (σ u) := fun u => ⟨s₀ u⟩
  have : Fintype Y := (X.toFinite.subset hYX).fintype
  rw [quasiLocalNet_finite]
  ext a
  rw [StarSubalgebra.mem_map, mem_range_localEmbed]
  constructor
  · rintro ⟨M, hM, rfl⟩
    obtain ⟨m', rfl⟩ := mem_localAlgebra_iff.1 hM
    refine ⟨Matrix.reindex (letterEquiv hYX).symm (letterEquiv hYX).symm m', ?_⟩
    rw [← localEmbed_embed s₀ hYX]
    simp
  · rintro ⟨m, rfl⟩
    exact ⟨_, embed_mem _ _, localEmbed_embed s₀ hYX m⟩

omit [DecidableEq Λ] [∀ u, Fintype (σ u)] [∀ u, DecidableEq (σ u)] in
/-- On a finite lattice every configuration is finitely supported, `F = σ_Λ`. -/
theorem finConfig_val_bijective [Finite Λ] :
    Function.Bijective (Subtype.val : FinConfig s₀ → Config σ) :=
  ⟨Subtype.val_injective, fun s => ⟨⟨s, Set.toFinite _⟩, rfl⟩⟩

/-- On a finite lattice the quasi-local algebra is all of the bounded operators, `A(Λ) = B`. -/
theorem quasiLocalAlgebra_eq_top_of_finite [Finite Λ] : quasiLocalAlgebra s₀ = ⊤ :=
  quasiLocalAlgebra_eq_top_of_finite_nontrivial s₀ (Set.toFinite _)

/-- On a finite lattice the quasi-local net is generating in the bounded operators. -/
theorem quasiLocalNet_isGenerating_of_finite [Finite Λ] : (quasiLocalNet s₀).IsGenerating :=
  quasiLocalNet_isGenerating_of_finite_nontrivial s₀ (Set.toFinite _)

/-- On a finite lattice the restricted net `A_ql` is the quasi-local net `A`, through the
inclusion. -/
theorem qlNet_isomorphic_quasiLocalNet_of_finite [Finite Λ] :
    Net.Isomorphic (subsetIndex Λ) (qlNet s₀) (quasiLocalNet s₀) :=
  qlNet_isomorphic_quasiLocalNet s₀ (quasiLocalAlgebra_eq_top_of_finite s₀)

variable (σ) in
/-- The configurations of `Λ` as the assignments of letters on the region `univ`. -/
def configUnivEquiv : Config σ ≃ ((x : (Set.univ : Set Λ)) → σ x) where
  toFun := restrict Set.univ
  invFun ξ u := ξ ⟨u, Set.mem_univ u⟩
  left_inv _ := rfl
  right_inv _ := rfl

variable [Fintype Λ]

/-- The qudit algebra of `Λ` as the matrices on the letters of the region `univ`. -/
def univReindex : QuditAlgebra σ ≃⋆ₐ[ℂ] Matrix ((x : (Set.univ : Set Λ)) → σ x)
    ((x : (Set.univ : Set Λ)) → σ x) ℂ :=
  StarAlgEquiv.ofAlgEquiv (Matrix.reindexAlgEquiv ℂ ℂ (configUnivEquiv σ)) fun M => by
    simp only [Matrix.coe_reindexAlgEquiv, Matrix.star_eq_conjTranspose,
      Matrix.conjTranspose_reindex]

theorem univReindex_apply (M : QuditAlgebra σ) :
    univReindex M = Matrix.reindex (configUnivEquiv σ) (configUnivEquiv σ) M :=
  rfl

/-- The embedding `embed` of a matrix on `O ⊆ Λ` into the qudit algebra of `Λ`, read on the region
`univ`, is the embedding of the same matrix on the subregion `{x : univ | ↑x ∈ O}`. -/
theorem univReindex_embed (O : Set Λ) (m : Matrix ((x : O) → σ x) ((x : O) → σ x) ℂ) :
    univReindex (embed O m) =
      embed (Subtype.val ⁻¹' O) (Matrix.reindex (letterEquiv (Set.subset_univ O))
        (letterEquiv (Set.subset_univ O)) m) := by
  ext ξ η
  rw [univReindex_apply, Matrix.reindex_apply, Matrix.submatrix_apply, embed_apply, embed_apply]
  have hA : AgreesOff O ((configUnivEquiv σ).symm ξ) ((configUnivEquiv σ).symm η) ↔
      AgreesOff (Subtype.val ⁻¹' O) ξ η :=
    ⟨fun h x hx => h x.1 hx, fun h u hu => h ⟨u, Set.mem_univ u⟩ hu⟩
  by_cases hc : AgreesOff O ((configUnivEquiv σ).symm ξ) ((configUnivEquiv σ).symm η)
  · rw [ite_eq_left hc, ite_eq_left (hA.1 hc)]
    rfl
  · rw [ite_eq_right hc, ite_eq_right (mt hA.2 hc)]

/-- The star homomorphism `M ↦ ι_Λ(M)` from the qudit algebra of the finite lattice to the bounded
operators. -/
def localEmbedUniv : QuditAlgebra σ →⋆ₐ[ℂ] (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀) :=
  (localEmbed s₀ Set.univ).comp univReindex.toStarAlgHom

theorem localEmbedUniv_apply (M : QuditAlgebra σ) :
    localEmbedUniv s₀ M = localEmbed s₀ Set.univ (univReindex M) :=
  rfl

/-- On a finite lattice, `ι_Λ` is a star isomorphism of the qudit algebra `M_Λ` onto the bounded
operators. -/
def localEmbedUnivEquiv : QuditAlgebra σ ≃⋆ₐ[ℂ] (ConfigSpace s₀ →L[ℂ] ConfigSpace s₀) :=
  StarAlgEquiv.ofBijective (localEmbedUniv s₀)
    ⟨(localEmbed_injective s₀ Set.univ).comp univReindex.injective,
      (localEmbed_surjective s₀ Set.univ fun u hu => absurd (Set.mem_univ u) hu).comp
        univReindex.surjective⟩

theorem localEmbedUnivEquiv_apply (M : QuditAlgebra σ) :
    localEmbedUnivEquiv s₀ M = localEmbedUniv s₀ M :=
  rfl

/-- On a finite lattice, `ι_Λ(m ⊗ 1) = ι_O(m)` for the extension `m ⊗ 1` (`embed`) of a matrix on
`O`. -/
theorem localEmbedUnivEquiv_embed (O : Set Λ) [Fintype O]
    (m : Matrix ((x : O) → σ x) ((x : O) → σ x) ℂ) :
    localEmbedUnivEquiv s₀ (embed O m) = localEmbed s₀ O m := by
  rw [localEmbedUnivEquiv_apply, localEmbedUniv_apply, univReindex_embed]
  exact localEmbed_embed s₀ (Set.subset_univ O) m

/-- On a finite lattice, `ι_Λ` carries the local algebra of every region `O` (`quditNet`) onto
`A(O)`. -/
theorem map_quditNet_localEmbedUnivEquiv (O : Set Λ) :
    (quditNet σ O).map (localEmbedUnivEquiv s₀).toStarAlgHom = quasiLocalNet s₀ O := by
  have : ∀ u, Nonempty (σ u) := fun u => ⟨s₀ u⟩
  have : Fintype O := Fintype.ofFinite O
  rw [quasiLocalNet_finite, quditNet_apply]
  ext a
  rw [StarSubalgebra.mem_map, mem_range_localEmbed]
  constructor
  · rintro ⟨M, hM, rfl⟩
    obtain ⟨m, rfl⟩ := mem_localAlgebra_iff.1 hM
    exact ⟨m, (localEmbedUnivEquiv_embed s₀ O m).symm⟩
  · rintro ⟨m, rfl⟩
    exact ⟨embed O m, embed_mem O m, localEmbedUnivEquiv_embed s₀ O m⟩

/-- On a finite lattice, the qudit net is isomorphic (`Net.Isomorphic`) to the quasi-local net,
through `ι_Λ`. -/
theorem quditNet_isomorphic_quasiLocalNet :
    Net.Isomorphic (subsetIndex Λ) (quditNet σ) (quasiLocalNet s₀) :=
  ⟨localEmbedUnivEquiv s₀, map_quditNet_localEmbedUnivEquiv s₀⟩

end Finite

end LocalAlgebrasLean.Qudit

end
