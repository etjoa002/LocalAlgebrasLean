import LocalAlgebrasLean.Qudit.Site

/-!
# A presentation of the qudit algebra by the matrix units of its sites

On a finite site set `Λ` with one alphabet `β` at every site, the qudit algebra is generated by
the matrix units `E^x_{ij}` of the sites, which satisfy at every site the relations of matrix units,
`E^x_{ij} E^x_{kl} = δ_{jk} E^x_{il}`, `∑_i E^x_{ii} = 1`, `(E^x_{ij})* = E^x_{ji}`, and commute
between different sites. These relations present the algebra: elements `e_x(i, j)` of a
star-algebra `B` that satisfy them are the images of the `E^x_{ij}` under a unital
star-homomorphism, and under only one. Uniqueness holds because the products over all the sites of
matrix units are the matrix units of the configurations (`list_prod_siteUnit`), which span the
algebra. For existence, the configuration matrix unit `|a⟩⟨a'|` is sent to the product
`∏_x e_x(a_x, a'_x)` of pairwise commuting factors; extended linearly, this map is multiplicative
by the relations at each site, unital since the diagonal sums factor over the sites, and preserves
stars since the star of a product of commuting factors is the product of their stars.

## Main statements

* `LocalAlgebrasLean.Qudit.algHom_ext_siteUnit`, `starAlgHom_ext_siteUnit`: homomorphisms out of
  the qudit algebra are determined by their values on the site matrix units.
* `LocalAlgebrasLean.Qudit.exists_starAlgHom_siteUnit`: every family satisfying the relations of
  site matrix units is the image of the site matrix units under a unital star-homomorphism.
* `LocalAlgebrasLean.Finset.star_noncommProd`: the star of a product of pairwise commuting factors
  is the product of their stars.
-/

noncomputable section

namespace LocalAlgebrasLean.Finset

/-- The star of a product of pairwise commuting factors is the product of their stars, which again
commute pairwise. -/
theorem star_noncommProd {ι M : Type*} [Monoid M] [StarMul M] (s : Finset ι) (f : ι → M)
    (comm : (s : Set ι).Pairwise (Function.onFun Commute f)) :
    star (s.noncommProd f comm) =
      s.noncommProd (fun i => star (f i)) fun _ hx _ hy hxy => (comm hx hy hxy).star_star := by
  classical
  suffices h : ∀ comm' : (s : Set ι).Pairwise (Function.onFun Commute fun i => star (f i)),
      star (s.noncommProd f comm) = s.noncommProd (fun i => star (f i)) comm' from h _
  intro comm'
  induction s using Finset.induction_on with
  | empty => rw [Finset.noncommProd_empty, Finset.noncommProd_empty, star_one]
  | insert a s ha ih =>
    rw [Finset.noncommProd_insert_of_notMem _ _ _ _ ha,
      Finset.noncommProd_insert_of_notMem _ _ _ _ ha, star_mul, ih]
    refine (Finset.noncommProd_commute _ _ _ _ fun y hy => ?_).eq.symm
    exact (comm (Finset.mem_insert_self a s) (Finset.mem_insert_of_mem hy)
      (fun h => ha (h ▸ hy))).star_star

end LocalAlgebrasLean.Finset

namespace LocalAlgebrasLean.Qudit

section Presentation

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ] {β : Type*} [Fintype β] [DecidableEq β]

section Ext

variable {B : Type*} [Semiring B] [Algebra ℂ B]

/-- Two algebra homomorphisms out of the qudit algebra of a finite site set that agree on the
matrix units `E^x_{ij}` of every site are equal, since the products of the matrix units of all the
sites are the matrix units of the configurations (`list_prod_siteUnit`). -/
theorem algHom_ext_siteUnit {φ ψ : QuditAlgebra (fun _ : Λ => β) →ₐ[ℂ] B}
    (h : ∀ x i j, φ (siteUnit (σ := fun _ : Λ => β) x i j) =
      ψ (siteUnit (σ := fun _ : Λ => β) x i j)) : φ = ψ := by
  have hsingle : ∀ a a' : Λ → β, φ (Matrix.single a a' 1) = ψ (Matrix.single a a' 1) := by
    intro a a'
    rw [← list_prod_siteUnit (σ := fun _ : Λ => β) (Finset.univ.nodup_toList)
      (fun y => Finset.mem_toList.mpr (Finset.mem_univ y)) a a', map_list_prod, map_list_prod,
      List.map_map, List.map_map]
    exact congrArg List.prod (List.map_congr_left fun y _ => h y (a y) (a' y))
  refine AlgHom.ext fun m => ?_
  rw [Matrix.matrix_eq_sum_single m]
  simp only [map_sum]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun a' _ => ?_
  have hm : Matrix.single a a' (m a a') = m a a' • Matrix.single a a' (1 : ℂ) := by
    rw [Matrix.smul_single, smul_eq_mul, mul_one]
  rw [hm, map_smul, map_smul, hsingle]

end Ext

variable {B : Type*} [Ring B] [StarRing B] [Algebra ℂ B] [StarModule ℂ B]

omit [StarModule ℂ B] in
/-- Two star-homomorphisms out of the qudit algebra of a finite site set that agree on the matrix
units of every site are equal. -/
theorem starAlgHom_ext_siteUnit {φ ψ : QuditAlgebra (fun _ : Λ => β) →⋆ₐ[ℂ] B}
    (h : ∀ x i j, φ (siteUnit (σ := fun _ : Λ => β) x i j) =
      ψ (siteUnit (σ := fun _ : Λ => β) x i j)) : φ = ψ :=
  StarAlgHom.ext fun m => congrArg (fun χ : QuditAlgebra (fun _ : Λ => β) →ₐ[ℂ] B => χ m)
    (algHom_ext_siteUnit (φ := φ.toAlgHom) (ψ := ψ.toAlgHom) h)

variable {e : Λ → β → β → B} (hcomm : ∀ x y, x ≠ y → ∀ i j k l, Commute (e x i j) (e y k l))

include hcomm in
omit [DecidableEq Λ] [Fintype β] [DecidableEq β] [StarRing B] [Algebra ℂ B] [StarModule ℂ B] in
private theorem siteProd_comm (a a' : Λ → β) :
    ((Finset.univ : Finset Λ) : Set Λ).Pairwise
      (Function.onFun Commute fun x => e x (a x) (a' x)) :=
  fun x _ y _ hxy => hcomm x y hxy _ _ _ _

/-- The product `∏_x e_x(a_x, a'_x)` over all the sites, of pairwise commuting factors. -/
private def siteProd (a a' : Λ → β) : B :=
  Finset.univ.noncommProd (fun x => e x (a x) (a' x)) (siteProd_comm hcomm a a')

variable {hcomm}

omit [DecidableEq Λ] [Fintype β] [StarRing B] [Algebra ℂ B] [StarModule ℂ B] in
private theorem siteProd_mul
    (hmul : ∀ x i j k l, e x i j * e x k l = if j = k then e x i l else 0) (a a' b b' : Λ → β) :
    siteProd hcomm a a' * siteProd hcomm b b' = if a' = b then siteProd hcomm a b' else 0 := by
  classical
  rw [siteProd, siteProd, ← Finset.noncommProd_mul_distrib (fun x => e x (a x) (a' x))
    (fun x => e x (b x) (b' x)) _ _ (fun x _ y _ hxy => hcomm x y hxy _ _ _ _)]
  split_ifs with h
  · subst h
    rw [siteProd]
    exact Finset.noncommProd_congr rfl (fun x _ => by rw [Pi.mul_apply, hmul, ite_eq_left rfl]) _
  · obtain ⟨x, hx⟩ := Function.ne_iff.mp h
    rw [← Finset.mul_noncommProd_erase _ (Finset.mem_univ x), Pi.mul_apply, hmul, ite_eq_right hx,
      zero_mul]

omit [Fintype β] [StarRing B] [Algebra ℂ B] [StarModule ℂ B] in
private theorem mul_siteProd
    (hmul : ∀ x i j k l, e x i j * e x k l = if j = k then e x i l else 0) (x : Λ) (i j : β)
    (b b' : Λ → β) :
    e x i j * siteProd hcomm b b' =
      if j = b x then siteProd hcomm (Function.update b x i) b' else 0 := by
  rw [siteProd, ← Finset.mul_noncommProd_erase _ (Finset.mem_univ x)
    (fun y => e y (b y) (b' y)), ← mul_assoc, hmul]
  split_ifs with h
  · rw [siteProd, ← Finset.mul_noncommProd_erase _ (Finset.mem_univ x)
      (fun y => e y (Function.update b x i y) (b' y)), Function.update_self]
    congr 1
    exact Finset.noncommProd_congr rfl
      (fun y hy => by rw [Function.update_of_ne (Finset.ne_of_mem_erase hy)]) _
  · rw [zero_mul]

omit [DecidableEq Λ] [Fintype β] [DecidableEq β] [Algebra ℂ B] [StarModule ℂ B] in
private theorem star_siteProd (hstar : ∀ x i j, star (e x i j) = e x j i) (a a' : Λ → β) :
    star (siteProd hcomm a a') = siteProd hcomm a' a := by
  classical
  rw [siteProd, siteProd, Finset.star_noncommProd]
  exact Finset.noncommProd_congr rfl (fun x _ => hstar x _ _) _

omit [DecidableEq Λ] [Fintype β] [DecidableEq β] [StarRing B] [Algebra ℂ B]
  [StarModule ℂ B] in
private theorem siteProd_eq_list_prod (a a' : Λ → β) :
    siteProd hcomm a a' = (List.ofFn fun k =>
      e ((Fintype.equivFin Λ).symm k) (a ((Fintype.equivFin Λ).symm k))
        (a' ((Fintype.equivFin Λ).symm k))).prod := by
  classical
  set π := (Fintype.equivFin Λ).symm
  have hu : (Finset.univ : Finset Λ) = (List.ofFn π).toFinset := by
    ext x
    simp only [Finset.mem_univ, List.mem_toFinset, List.mem_ofFn, true_iff]
    exact ⟨π.symm x, π.apply_symm_apply x⟩
  rw [siteProd]
  calc _ = ((List.ofFn π).toFinset).noncommProd (fun x => e x (a x) (a' x)) _ :=
        Finset.noncommProd_congr hu (fun _ _ => rfl) _
    _ = ((List.ofFn π).map fun x => e x (a x) (a' x)).prod :=
        Finset.noncommProd_toFinset _ _ _ (List.nodup_ofFn.mpr π.injective)
    _ = _ := by rw [List.map_ofFn]; rfl

omit [DecidableEq β] [StarRing B] [Algebra ℂ B] [StarModule ℂ B] in
private theorem sum_siteProd_self (hsum : ∀ x, ∑ i, e x i i = 1) :
    ∑ a, siteProd hcomm a a = 1 := by
  set π := (Fintype.equivFin Λ).symm
  calc ∑ a, siteProd hcomm a a
      = ∑ c : Fin (Fintype.card Λ) → β, (List.ofFn fun k => e (π k) (c k) (c k)).prod :=
        Fintype.sum_equiv (Equiv.arrowCongr π.symm (Equiv.refl β)) _ _
          (fun a => siteProd_eq_list_prod a a)
    _ = (List.ofFn fun k => ∑ c, e (π k) c c).prod :=
        (list_prod_ofFn_sum (S := fun _ => β) (fun k c => e (π k) c c)).symm
    _ = 1 := by simp [hsum]

private theorem siteUnit_mul_single (x : Λ) (i j : β) (b b' : Λ → β) :
    siteUnit (σ := fun _ : Λ => β) x i j * Matrix.single b b' (1 : ℂ) =
      if b x = j then Matrix.single (Function.update b x i) b' 1 else 0 := by
  ext s s'
  rw [siteUnit_mul_apply]
  by_cases hs : s x = i <;> by_cases hb : b x = j
  · rw [ite_eq_left hs, ite_eq_left hb, Matrix.single_apply, Matrix.single_apply]
    refine if_congr (and_congr_left' ⟨fun h => ?_, fun h => ?_⟩) rfl rfl
    · rw [h, Function.update_idem, ← hs, Function.update_eq_self]
    · rw [← h, Function.update_idem, ← hb, Function.update_eq_self]
  · rw [ite_eq_left hs, ite_eq_right hb, Matrix.single_apply, Matrix.zero_apply, ite_eq_right]
    rintro ⟨h1, -⟩
    exact hb (by rw [h1, Function.update_self])
  · rw [ite_eq_right hs, ite_eq_left hb, Matrix.single_apply, ite_eq_right]
    rintro ⟨h1, -⟩
    exact hs (by rw [← h1, Function.update_self])
  · rw [ite_eq_right hs, ite_eq_right hb, Matrix.zero_apply]

variable (hcomm) in
/-- The linear map `m ↦ ∑_{a a'} m(a, a') ∏_x e_x(a_x, a'_x)`. -/
private def presentLinear : QuditAlgebra (fun _ : Λ => β) →ₗ[ℂ] B where
  toFun m := ∑ a, ∑ a', m a a' • siteProd hcomm a a'
  map_add' m n := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' c m := by simp [Finset.smul_sum, smul_smul]

omit [DecidableEq β] [StarRing B] [StarModule ℂ B] in
private theorem presentLinear_apply (m : QuditAlgebra (fun _ : Λ => β)) :
    presentLinear hcomm m = ∑ a, ∑ a', m a a' • siteProd hcomm a a' := rfl

omit [StarRing B] [StarModule ℂ B] in
private theorem presentLinear_single (b b' : Λ → β) :
    presentLinear hcomm (Matrix.single b b' 1) = siteProd hcomm b b' := by
  rw [presentLinear_apply]
  simp only [Matrix.single_apply, ite_smul, one_smul, zero_smul]
  rw [Finset.sum_eq_single b (fun a _ ha => Finset.sum_eq_zero fun a' _ => by
      rw [ite_eq_right fun h => ha h.1.symm]) (fun h => absurd (Finset.mem_univ b) h)]
  rw [Finset.sum_eq_single b' (fun a' _ ha => by rw [ite_eq_right fun h => ha h.2.symm])
    (fun h => absurd (Finset.mem_univ b') h)]
  simp

/-- A presentation of the qudit algebra of a finite site set by the matrix units of its sites:
elements `e_x(i, j)` of a star-algebra that satisfy, at every site `x`, the relations of matrix
units, `e_x(i, j) e_x(k, l) = δ_{jk} e_x(i, l)`, `∑_i e_x(i, i) = 1`, `e_x(i, j)* = e_x(j, i)`,
and commute between different sites, are the images of the matrix units `E^x_{ij}` under a
unital star-homomorphism (unique by `starAlgHom_ext_siteUnit`). -/
theorem exists_starAlgHom_siteUnit (e : Λ → β → β → B)
    (hmul : ∀ x i j k l, e x i j * e x k l = if j = k then e x i l else 0)
    (hsum : ∀ x, ∑ i, e x i i = 1) (hstar : ∀ x i j, star (e x i j) = e x j i)
    (hcomm : ∀ x y, x ≠ y → ∀ i j k l, Commute (e x i j) (e y k l)) :
    ∃ φ : QuditAlgebra (fun _ : Λ => β) →⋆ₐ[ℂ] B,
      ∀ x i j, φ (siteUnit (σ := fun _ : Λ => β) x i j) = e x i j := by
  have hone : presentLinear hcomm 1 = 1 := by
    rw [presentLinear_apply]
    simp only [Matrix.one_apply, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq,
      Finset.mem_univ, ite_true]
    exact sum_siteProd_self hsum
  have hmul' : ∀ m n, presentLinear hcomm (m * n) =
      presentLinear hcomm m * presentLinear hcomm n := by
    intro m n
    have key : ∀ a a' : Λ → β, ∑ b, ∑ b', (m a a' * n b b') •
        (if a' = b then siteProd hcomm a b' else 0) =
          ∑ b', (m a a' * n a' b') • siteProd hcomm a b' := by
      intro a a'
      rw [Finset.sum_eq_single a' (fun b _ hb => Finset.sum_eq_zero fun b' _ => by
        rw [ite_eq_right (Ne.symm hb), smul_zero]) (fun h => absurd (Finset.mem_univ a') h)]
      exact Finset.sum_congr rfl fun b' _ => by rw [ite_eq_left rfl]
    calc presentLinear hcomm (m * n)
        = ∑ a, ∑ a', ∑ b', (m a a' * n a' b') • siteProd hcomm a b' := by
          simp only [presentLinear_apply, Matrix.mul_apply, Finset.sum_smul]
          exact Finset.sum_congr rfl fun a _ => Finset.sum_comm
      _ = presentLinear hcomm m * presentLinear hcomm n := by
          rw [presentLinear_apply, presentLinear_apply, Finset.sum_mul]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun a' _ => ?_
          rw [Finset.mul_sum]
          simp only [Finset.mul_sum, smul_mul_smul_comm, siteProd_mul hmul]
          exact (key a a').symm
  let φ : QuditAlgebra (fun _ : Λ => β) →⋆ₐ[ℂ] B :=
    { AlgHom.ofLinearMap (presentLinear hcomm) hone hmul' with
      map_star' := fun m => by
        change presentLinear hcomm (star m) = star (presentLinear hcomm m)
        simp only [presentLinear_apply, star_sum, star_smul, star_siteProd hstar,
          Matrix.star_apply]
        exact Finset.sum_comm }
  have hφ : ∀ m, φ m = presentLinear hcomm m := fun _ => rfl
  refine ⟨φ, fun x i j => ?_⟩
  have h1 : siteUnit (σ := fun _ : Λ => β) x i j =
      ∑ b, siteUnit (σ := fun _ : Λ => β) x i j * Matrix.single b b 1 := by
    rw [← Finset.mul_sum, Matrix.sum_single_one, mul_one]
  rw [h1, map_sum]
  simp only [siteUnit_mul_single, apply_ite φ, map_zero, hφ, presentLinear_single]
  have h2 : ∀ b : Λ → β, (if b x = j then siteProd hcomm (Function.update b x i) b else 0) =
      e x i j * siteProd hcomm b b := fun b => by
    rw [mul_siteProd hmul]
    exact if_congr eq_comm rfl rfl
  rw [Finset.sum_congr rfl fun b _ => h2 b, ← Finset.mul_sum, sum_siteProd_self hsum, mul_one]

end Presentation

end LocalAlgebrasLean.Qudit

end
