import LocalAlgebrasLean.Lattice.Basic

/-!
# Neighbourhoods of regions generated by single sites

For a map `Θ` of the regions of a set of sites (a neighbourhood, for instance the region into
which an automorphism moves the observables of a region), the sets `Θ {y}` are the light cones of
the single sites. Two neighbourhoods are built from them: the transposed neighbourhood
`Θᵀ O = {y | Θ {y} ∩ O ≠ ∅}`, the sites whose light cone meets `O`, and the neighbourhood
generated by points `⋃ y ∈ O, Θ {y}`. Transposing twice gives the latter, and on an abelian group
the transpose of `O ↦ O + N` is `O ↦ O - N`.

These are QCALean qudit U1, Definition 4 and Lemma 5, placed here by the placement rule (U1
amendment 2, user, 20 Oct 2026): they are statements about regions only.

## Main definitions

* `LocalAlgebrasLean.transposeNbhd`, `LocalAlgebrasLean.unionNbhd`
* `LocalAlgebrasLean.transposeNbhd_transposeNbhd`, `LocalAlgebrasLean.transposeNbhd_add`,
  `LocalAlgebrasLean.unionNbhd_add`
-/

open scoped Pointwise

namespace LocalAlgebrasLean

variable {V : Type*}

/-- QCALean qudit U1, Definition 4: the transposed neighbourhood of `Θ`, the set of sites `y` whose
neighbourhood `Θ {y}` meets `O`. -/
def transposeNbhd (Θ : Set V → Set V) (O : Set V) : Set V := {y | (Θ {y} ∩ O).Nonempty}

/-- QCALean qudit U1, Definition 4: the neighbourhood of `O` generated by its points,
`⋃ y ∈ O, Θ {y}`. -/
def unionNbhd (Θ : Set V → Set V) (O : Set V) : Set V := ⋃ y ∈ O, Θ {y}

/-- A site lies in the transposed neighbourhood of `O` if its neighbourhood meets `O`. -/
theorem mem_transposeNbhd {Θ : Set V → Set V} {O : Set V} {y : V} :
    y ∈ transposeNbhd Θ O ↔ (Θ {y} ∩ O).Nonempty := Iff.rfl

/-- A site lies in the neighbourhood of `O` generated by points if it lies in the neighbourhood
of some point of `O`. -/
theorem mem_unionNbhd {Θ : Set V → Set V} {O : Set V} {x : V} :
    x ∈ unionNbhd Θ O ↔ ∃ y ∈ O, x ∈ Θ {y} := by
  simp [unionNbhd]

/-- QCALean qudit U1, Lemma 5(a): transposing twice gives the neighbourhood generated by points. -/
theorem transposeNbhd_transposeNbhd (Θ : Set V → Set V) :
    transposeNbhd (transposeNbhd Θ) = unionNbhd Θ := by
  ext O x
  rw [mem_transposeNbhd, mem_unionNbhd]
  constructor
  · rintro ⟨y, hy, hyO⟩
    exact ⟨y, hyO, Set.inter_singleton_nonempty.mp (mem_transposeNbhd.mp hy)⟩
  · rintro ⟨y, hyO, hy⟩
    exact ⟨y, mem_transposeNbhd.mpr (Set.inter_singleton_nonempty.mpr hy), hyO⟩

variable {G : Type*} [AddCommGroup G]

/-- QCALean qudit U1, Lemma 5(b), first part: the transpose of `O ↦ O + N` is `O ↦ O - N`. -/
theorem transposeNbhd_add (N : Set G) :
    transposeNbhd (fun O => O + N) = fun O => O + -N := by
  ext O y
  simp only [mem_transposeNbhd, Set.singleton_add, Set.mem_add, Set.mem_neg]
  constructor
  · rintro ⟨_, ⟨n, hn, rfl⟩, hO⟩
    exact ⟨y + n, hO, -n, by simpa using hn, by simp⟩
  · rintro ⟨o, ho, m, hm, rfl⟩
    exact ⟨o, ⟨-m, hm, by simp⟩, ho⟩

/-- QCALean qudit U1, Lemma 5(b), second part: `O ↦ O + N` is generated by its points. -/
theorem unionNbhd_add (N : Set G) : unionNbhd (fun O => O + N) = fun O => O + N := by
  ext O x
  simp only [mem_unionNbhd, Set.singleton_add, Set.mem_add, Set.mem_image]

end LocalAlgebrasLean
