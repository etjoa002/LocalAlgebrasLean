import LocalAlgebrasLean.Net.Basic
import Mathlib.Analysis.CStarAlgebra.Hom

/-!
# Generated nets

The net generated by a monotone family of subsets `G O` of a C*-algebra assigns to `O` the
C*-subalgebra generated by `G O`. Generation, local commutativity and covariance of the net then
follow from statements about the generators alone. Local commutativity requires generators closed
under the adjoint; its proof uses that the commutant of a set is closed. The time-slice property
belongs to LinearAQFT, being an axiom of quantum field theory.

## Main definitions and statements

* `LocalAlgebrasLean.Net.generated`, `generated_isGenerating`, `generated_isCovariancePair`.
* `LocalAlgebrasLean.commute_of_mem_closure`, `commute_topologicalClosure_adjoin`: commuting
  generators, one set closed under the adjoint, give commuting closed generated star algebras.
* `LocalAlgebrasLean.Net.generated_isLocallyCommutative`: generators closed under the adjoint,
  commuting for orthogonal regions, give a locally commutative net.
-/

namespace LocalAlgebrasLean

open StarAlgebra StarSubalgebra

variable {A : Type*} [CStarAlgebra A]

/-! ### Commuting generated algebras -/

/-- Elementwise commuting sets have elementwise commuting closures: the commutant of a set is
closed, multiplication being separately continuous. -/
theorem commute_of_mem_closure {S T : Set A} (h : ∀ a ∈ S, ∀ b ∈ T, Commute a b) :
    ∀ a ∈ closure S, ∀ b ∈ closure T, Commute a b := by
  have h1 : closure S ⊆ T.centralizer :=
    closure_minimal (fun a ha b hb => (h a ha b hb).eq.symm) (Set.isClosed_centralizer T)
  have h2 : closure T ⊆ (closure S).centralizer :=
    closure_minimal (fun b hb a ha => (h1 ha b hb).symm) (Set.isClosed_centralizer _)
  exact fun a ha b hb => h2 hb a ha

/-- If `S` is closed under the adjoint and its elements commute with those of `T`, then the closed
star subalgebras generated by `S` and by `T` commute elementwise. -/
theorem commute_topologicalClosure_adjoin {S T : Set A} (hS : ∀ a ∈ S, star a ∈ S)
    (h : ∀ a ∈ S, ∀ b ∈ T, Commute a b) :
    ∀ a ∈ (adjoin ℂ S).topologicalClosure, ∀ b ∈ (adjoin ℂ T).topologicalClosure,
      Commute a b := by
  have hT : adjoin ℂ T ≤ centralizer ℂ S := by
    refine adjoin_le fun b hb => ?_
    rw [SetLike.mem_coe, mem_centralizer_iff]
    exact fun g hg => ⟨(h g hg b hb).eq, (h _ (hS g hg) b hb).eq⟩
  have hS' : adjoin ℂ S ≤ centralizer ℂ (adjoin ℂ T : Set A) := by
    refine adjoin_le fun a ha => ?_
    rw [SetLike.mem_coe, mem_centralizer_iff]
    intro g hg
    have hg' := (mem_centralizer_iff ℂ).1 (hT hg)
    have hsg := (mem_centralizer_iff ℂ).1 (hT (star_mem hg))
    exact ⟨(hg' a ha).1.symm, (hsg a ha).1.symm⟩
  intro a ha b hb
  rw [← SetLike.mem_coe, topologicalClosure_coe] at ha hb
  refine commute_of_mem_closure (fun a ha b hb => ?_) a ha b hb
  exact ((mem_centralizer_iff ℂ).1 (hS' ha) b hb).1.symm

namespace Net

variable {R R' : Type*} [Preorder R] [Preorder R'] {A' : Type*} [CStarAlgebra A']

/-- The net generated by a monotone family of subsets of `A`. -/
def generated (G : R →o Set A) : Net R A where
  toOrderHom :=
    { toFun := fun O => (adjoin ℂ (G O)).topologicalClosure
      monotone' := fun _ _ h => topologicalClosure_mono (adjoin_mono (G.monotone h)) }
  isClosed _ := isClosed_topologicalClosure _

theorem generated_apply (G : R →o Set A) (O : R) :
    generated G O = (adjoin ℂ (G O)).topologicalClosure := rfl

theorem subset_generated (G : R →o Set A) (O : R) : G O ⊆ generated G O :=
  fun _ ha => le_topologicalClosure _ (subset_adjoin ℂ _ ha)

/-- If the generators of all regions together generate `A`, the generated net is generating. -/
theorem generated_isGenerating (G : R →o Set A)
    (h : (adjoin ℂ (⋃ O, G O)).topologicalClosure = ⊤) :
    IsGenerating (generated G) := by
  rw [IsGenerating, _root_.eq_top_iff, ← h]
  apply topologicalClosure_mono
  rw [adjoin_le_iff]
  intro a ha
  obtain ⟨O, hO⟩ := Set.mem_iUnion.1 ha
  exact le_iSup (fun O => generated G O) O (subset_generated G O hO)

/-- If the generators are closed under the adjoint and the generators of orthogonal regions commute,
the generated net is locally commutative. -/
theorem generated_isLocallyCommutative {I : RegionIndex R} (G : R →o Set A)
    (hstar : ∀ O, ∀ a ∈ G O, star a ∈ G O)
    (h : ∀ ⦃O₁ O₂ : R⦄, I.Orthogonal O₁ O₂ → ∀ a ∈ G O₁, ∀ b ∈ G O₂, Commute a b) :
    IsLocallyCommutative I (generated G) :=
  fun _ _ hO => commute_topologicalClosure_adjoin (hstar _) (h hO)

/-- A star isomorphism of C*-algebras is a homeomorphism. -/
private def homeomorphOfStarAlgEquiv (α : A ≃⋆ₐ[ℂ] A') : A ≃ₜ A' where
  toEquiv := α.toEquiv
  continuous_toFun := (NonUnitalStarAlgHom.isometry α α.injective).continuous
  continuous_invFun := (NonUnitalStarAlgHom.isometry α.symm α.symm.injective).continuous

/-- A star isomorphism mapping generators onto generators gives a covariance pair of the generated
nets. -/
theorem generated_isCovariancePair {I : RegionIndex R} {I' : RegionIndex R'} (G : R →o Set A)
    (G' : R' →o Set A') (κ : I.Iso I') (α : A ≃⋆ₐ[ℂ] A')
    (h : ∀ O, α '' G O = G' (κ O)) :
    IsCovariancePair (generated G) (generated G') κ α := by
  intro O
  rw [generated_apply, generated_apply, ← h O]
  have hc : Continuous α.toStarAlgHom := (homeomorphOfStarAlgEquiv α).continuous
  have hcl : IsClosedMap α.toStarAlgHom := (homeomorphOfStarAlgEquiv α).isClosedMap
  rw [← topologicalClosure_map _ _ hcl hc, StarAlgHom.map_adjoin]
  rfl

end Net

end LocalAlgebrasLean
