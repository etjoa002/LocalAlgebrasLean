import LocalAlgebrasLean.Region.Basic
import Mathlib.Analysis.CStarAlgebra.Classes
import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# Nets of local algebras

A net assigns to each region a norm-closed star subalgebra of one ambient C*-algebra, larger
regions receiving larger algebras (isotony). The properties a net may have are stated separately:
generation of the ambient algebra, commutation of the algebras of orthogonal regions (local
commutativity), and covariance under isomorphisms of the regions. A net carries no time and no
dynamics; theories add their own axioms on top (for example the time slice of algebraic quantum
field theory, in LinearAQFT).

Moved from LinearAQFT `Net/Basic.lean` (milestone A, Definitions 3 and 5, Lemma 6), indexed by a
`RegionIndex`; LinearAQFT's causality axiom (N2) is `IsLocallyCommutative` here. Milestone L1.

## Main definitions

* `LocalAlgebrasLean.Net R A`: a net over regions `R` in the C*-algebra `A`.
* `LocalAlgebrasLean.Net.IsGenerating`, `LocalAlgebrasLean.Net.IsLocallyCommutative`.
* `LocalAlgebrasLean.Net.IsCovariancePair`, `LocalAlgebrasLean.Net.Isomorphic`,
  `LocalAlgebrasLean.Net.IsCovariantUnder`.
-/

namespace LocalAlgebrasLean

/-- A net (L1, Definition 3; LinearAQFT milestone A, Definition 3): a monotone assignment of
norm-closed star subalgebras of `A` to regions. Monotonicity is isotony. -/
structure Net (R : Type*) [Preorder R] (A : Type*) [CStarAlgebra A] where
  /-- The local algebras, monotone in the region. -/
  toOrderHom : R →o StarSubalgebra ℂ A
  isClosed : ∀ O, IsClosed (toOrderHom O : Set A)

namespace Net

variable {R R' R'' : Type*} [Preorder R] [Preorder R'] [Preorder R'']
variable {A A' A'' : Type*} [CStarAlgebra A] [CStarAlgebra A'] [CStarAlgebra A'']

instance : CoeFun (Net R A) (fun _ => R → StarSubalgebra ℂ A) := ⟨fun 𝒜 => 𝒜.toOrderHom⟩

theorem mono (𝒜 : Net R A) {O O' : R} (h : O ≤ O') : 𝒜 O ≤ 𝒜 O' :=
  𝒜.toOrderHom.monotone h

/-- Each local algebra is closed, hence a C*-algebra. -/
instance (𝒜 : Net R A) (O : R) : IsClosed ((𝒜 O : StarSubalgebra ℂ A) : Set A) :=
  𝒜.isClosed O

/-- Generation (LinearAQFT milestone A, axiom N1): the C*-subalgebra generated by all local
algebras is `A`. -/
def IsGenerating (𝒜 : Net R A) : Prop :=
  (⨆ O, 𝒜 O).topologicalClosure = ⊤

/-- Local commutativity (LinearAQFT milestone A, axiom N2, there called causality): the local
algebras of orthogonal regions commute. -/
def IsLocallyCommutative (I : RegionIndex R) (𝒜 : Net R A) : Prop :=
  ∀ ⦃O₁ O₂ : R⦄, I.Orthogonal O₁ O₂ → ∀ a ∈ 𝒜 O₁, ∀ b ∈ 𝒜 O₂, Commute a b

/-- A covariance pair (LinearAQFT milestone A, Definition 5, for isomorphisms of region indices): an
isomorphism `κ` of region indices and a star isomorphism `α` with
`α (𝒜 O) = 𝒜' (κ O)` for every region `O`. -/
def IsCovariancePair {I : RegionIndex R} {I' : RegionIndex R'} (𝒜 : Net R A) (𝒜' : Net R' A')
    (κ : I.Iso I') (α : A ≃⋆ₐ[ℂ] A') : Prop :=
  ∀ O, (𝒜 O).map α.toStarAlgHom = 𝒜' (κ O)

/-- Two nets over the same region index are isomorphic (Dimock, p. 220) if a star isomorphism of
the ambient algebras maps each local algebra onto the corresponding one. The region index plays
no role, since the identity preserves any orthogonality. -/
def Isomorphic (I : RegionIndex R) (𝒜 : Net R A) (𝒜' : Net R A') : Prop :=
  ∃ α : A ≃⋆ₐ[ℂ] A', IsCovariancePair 𝒜 𝒜' (RegionIndex.Iso.refl I) α

/-- Covariance under a group `Γ` acting on the region index through `κ` and on `A` through
`α`, both group homomorphisms: every `(κ γ, α γ)` is a covariance pair. -/
def IsCovariantUnder {Γ : Type*} [Group Γ] {I : RegionIndex R} (𝒜 : Net R A)
    (κ : Γ →* I.Aut) (α : Γ →* (A ≃⋆ₐ[ℂ] A)) : Prop :=
  ∀ γ, IsCovariancePair 𝒜 𝒜 (κ γ) (α γ)

variable {I : RegionIndex R} {I' : RegionIndex R'} {I'' : RegionIndex R''}

/-- LinearAQFT milestone A, Lemma 6 (first part): the identity pair is a covariance pair. -/
theorem isCovariancePair_refl (𝒜 : Net R A) :
    IsCovariancePair 𝒜 𝒜 (RegionIndex.Iso.refl I) (StarAlgEquiv.refl ℂ A) := by
  intro O
  exact StarSubalgebra.map_id (𝒜 O)

/-- LinearAQFT milestone A, Lemma 6 (second part): covariance pairs compose. -/
theorem IsCovariancePair.trans {𝒜 : Net R A} {𝒜' : Net R' A'} {𝒜'' : Net R'' A''}
    {κ₁ : I.Iso I'} {α₁ : A ≃⋆ₐ[ℂ] A'} {κ₂ : I'.Iso I''} {α₂ : A' ≃⋆ₐ[ℂ] A''}
    (h₁ : IsCovariancePair 𝒜 𝒜' κ₁ α₁) (h₂ : IsCovariancePair 𝒜' 𝒜'' κ₂ α₂) :
    IsCovariancePair 𝒜 𝒜'' (κ₁.trans κ₂) (α₁.trans α₂) := by
  intro O
  rw [RegionIndex.Iso.trans_apply, ← h₂, ← h₁, StarSubalgebra.map_map]
  rfl

/-- LinearAQFT milestone A, Lemma 6 (third part): the inverse of a covariance pair. -/
theorem IsCovariancePair.symm {𝒜 : Net R A} {𝒜' : Net R' A'} {κ : I.Iso I'}
    {α : A ≃⋆ₐ[ℂ] A'} (h : IsCovariancePair 𝒜 𝒜' κ α) :
    IsCovariancePair 𝒜' 𝒜 κ.symm α.symm := by
  intro O'
  have h' := h (κ.symm O')
  rw [RegionIndex.Iso.apply_symm_apply] at h'
  rw [← h', StarSubalgebra.map_map]
  convert StarSubalgebra.map_id (𝒜 (κ.symm O'))
  ext a
  simp

end Net

end LocalAlgebrasLean
