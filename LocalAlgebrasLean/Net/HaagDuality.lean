import LocalAlgebrasLean.Net.Comap
import LocalAlgebrasLean.Net.Generated

/-!
# Haag duality

A net has Haag duality for a complement map `O ↦ O^c` of its regions if every element of the
ambient algebra commuting with `𝒜 (O^c)` lies in `𝒜 O`. For regions made of sites the complement is
the set complement; in quantum field theory it is the causal complement, so the definition is
stated for any regions and any complement map. When `O` and `O^c` are orthogonal, local
commutativity gives the reverse inclusion, and Haag duality is the equality `𝒜(O^c)' ∩ A = 𝒜(O)`.

For nets over the subsets of a set of sites, Haag duality on single sites asks the same of the
elements commuting with the algebra of every site outside a region. It implies Haag duality for
the set complement, and for an additive net, whose local algebras are generated by their
single-site algebras, the two are equivalent. The form on single sites is preserved by blocking,
and a net that has it exhausts the ambient algebra. The qudit net has both forms
(`LocalAlgebrasLean.Qudit.quditNet_isHaagDualOnSites`).

## Main definitions and statements

* `LocalAlgebrasLean.Net.IsHaagDual`, `IsHaagDual.mem_iff`.
* `LocalAlgebrasLean.Net.IsHaagDualOnSites`, `IsHaagDualOnSites.isHaagDual`,
  `IsHaagDualOnSites.apply_univ`, `IsHaagDualOnSites.block`.
* `LocalAlgebrasLean.Net.IsAdditive`, `IsAdditive.commute`, `isHaagDualOnSites_iff_isHaagDual`.

Statement numbers L8.n refer to the proposal of milestone L8.
-/

namespace LocalAlgebrasLean

namespace Net

open StarAlgebra StarSubalgebra

section General

variable {R : Type*} [Preorder R] {A : Type*} [CStarAlgebra A]

/-- L8, Definition 1: Haag duality for the complement map `c`: every element commuting with
`𝒜 (c O)` lies in `𝒜 O`, for every region `O`. -/
def IsHaagDual (c : R → R) (𝒜 : Net R A) : Prop :=
  ∀ (O : R) (b : A), (∀ a ∈ 𝒜 (c O), Commute b a) → b ∈ 𝒜 O

/-- L8, remark after Definition 1: with local commutativity and each region orthogonal to its
complement, Haag duality is the equality of `𝒜 O` with the commutant of `𝒜 (c O)`. -/
theorem IsHaagDual.mem_iff {c : R → R} {𝒜 : Net R A} (h : 𝒜.IsHaagDual c) {I : RegionIndex R}
    (hLC : 𝒜.IsLocallyCommutative I) (horth : ∀ O, I.Orthogonal O (c O)) (O : R) (b : A) :
    b ∈ 𝒜 O ↔ ∀ a ∈ 𝒜 (c O), Commute b a :=
  ⟨fun hb a ha => hLC (horth O) b hb a ha, h O b⟩

end General

section Sites

variable {V W : Type*} {A : Type*} [CStarAlgebra A]

/-- L8, Definition 2 (QCALean U1, Definition 6): Haag duality on single sites: for every region
`Q`, an element of the ambient algebra that commutes with the algebra of every single site outside
`Q` lies in the algebra of `Q`. -/
def IsHaagDualOnSites (𝒜 : Net (Set V) A) : Prop :=
  ∀ (Q : Set V) (b : A), (∀ y ∉ Q, ∀ c ∈ 𝒜 {y}, Commute b c) → b ∈ 𝒜 Q

/-- L8, Proposition 6, first part: Haag duality on single sites implies Haag duality for the set
complement. -/
theorem IsHaagDualOnSites.isHaagDual {𝒜 : Net (Set V) A} (h : 𝒜.IsHaagDualOnSites) :
    𝒜.IsHaagDual compl := by
  intro Q b hb
  apply h Q b
  intro y hy c hc
  exact hb c (𝒜.mono (by simpa using hy) hc)

/-- L8, remark after Definition 2: a net with Haag duality on single sites exhausts the ambient
algebra: the algebra of all sites is `A`. -/
theorem IsHaagDualOnSites.apply_univ {𝒜 : Net (Set V) A} (h : 𝒜.IsHaagDualOnSites) :
    𝒜 Set.univ = ⊤ := by
  refine eq_top_iff.mpr fun b _ => h Set.univ b ?_
  intro y hy
  exact absurd (Set.mem_univ y) hy

/-- QCALean U1, Lemma 11: blocking preserves Haag duality on single sites: an element commuting
with the algebras of
the blocks outside `Q` commutes with the algebra of every site outside `σ⁻¹ Q`, because each such
site lies in a block outside `Q`. -/
theorem IsHaagDualOnSites.block {𝒜 : Net (Set V) A} (h : 𝒜.IsHaagDualOnSites) (σ : V → W) :
    (𝒜.block σ).IsHaagDualOnSites := by
  intro Q b hb
  apply h (σ ⁻¹' Q) b
  intro y hy c hc
  have hle : 𝒜 {y} ≤ 𝒜 (σ ⁻¹' {σ y}) := 𝒜.mono (by simp)
  exact hb (σ y) hy c (hle hc)

/-- L8, before Proposition 6: additivity over single sites: the algebra of every region is the
closed unital star subalgebra generated by the algebras of its sites. -/
def IsAdditive (𝒜 : Net (Set V) A) : Prop :=
  ∀ P : Set V, 𝒜 P = (adjoin ℂ (⋃ y ∈ P, (𝒜 {y} : Set A))).topologicalClosure

/-- L8, proof of Proposition 6: for an additive net, an element commuting with the algebra of
every site of `P` commutes with `𝒜 P`. -/
theorem IsAdditive.commute {𝒜 : Net (Set V) A} (hA : 𝒜.IsAdditive) {P : Set V} {b : A}
    (hb : ∀ y ∈ P, ∀ c ∈ 𝒜 {y}, Commute b c) : ∀ c ∈ 𝒜 P, Commute b c := by
  intro c hc
  rw [hA P] at hc
  have hS : ∀ a ∈ ⋃ y ∈ P, (𝒜 {y} : Set A), star a ∈ ⋃ y ∈ P, (𝒜 {y} : Set A) := by
    intro a ha
    simp only [Set.mem_iUnion, SetLike.mem_coe, exists_prop] at ha ⊢
    obtain ⟨y, hy, ha⟩ := ha
    exact ⟨y, hy, star_mem ha⟩
  have h := commute_topologicalClosure_adjoin (T := {b}) hS (fun a ha b' hb' => by
    rw [Set.mem_singleton_iff] at hb'
    simp only [Set.mem_iUnion, SetLike.mem_coe, exists_prop] at ha
    obtain ⟨y, hy, ha⟩ := ha
    rw [hb']
    exact (hb y hy a ha).symm)
  exact (h c hc b (le_topologicalClosure _ (subset_adjoin ℂ _ rfl))).symm

/-- L8, Proposition 6: for an additive net, Haag duality on single sites is Haag duality for the
set complement. -/
theorem isHaagDualOnSites_iff_isHaagDual {𝒜 : Net (Set V) A} (hA : 𝒜.IsAdditive) :
    𝒜.IsHaagDualOnSites ↔ 𝒜.IsHaagDual compl := by
  refine ⟨IsHaagDualOnSites.isHaagDual, fun h Q b hb => h Q b ?_⟩
  exact hA.commute fun y hy c hc => hb y hy c hc

end Sites

end Net

end LocalAlgebrasLean
